{
  "name": "warp-vs-isp-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Contracts and validation for the WARP versus ISP benchmark",
  "type": "module",
  "scripts": {
    "fixtures": "node tests/generate-fixtures.mjs",
    "test:contracts": "node tests/generate-fixtures.mjs --check && node tests/validate-contracts.mjs",
    "test:runner": "node tests/validate-runner.mjs",
    "test:bash": "bash tests/warp-bench.tests.sh",
    "test:powershell": "pwsh -NoLogo -NoProfile -File tests/warp-bench.tests.ps1",
    "test": "npm run test:contracts && npm run test:runner && npm run test:bash"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
