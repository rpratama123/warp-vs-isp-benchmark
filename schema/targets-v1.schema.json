{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:warp-vs-isp-benchmark:schema:targets-v1",
  "title": "WARP vs ISP Benchmark Target Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "published_at", "targets"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_version": { "$ref": "#/$defs/version" },
    "published_at": { "$ref": "#/$defs/timestamp" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "checked_at", "usage_policy"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://", "maxLength": 500 },
        "checked_at": { "$ref": "#/$defs/timestamp" },
        "usage_policy": { "enum": ["operator_documented", "public_directory_listed", "unknown"] }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "hostname", "ports", "supports_reverse", "supports_icmp", "verification_status", "verified_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "priority": { "type": "integer", "minimum": 1 },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 253 },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "supports_reverse": { "enum": ["yes", "no", "unknown"] },
        "supports_icmp": { "enum": ["yes", "no", "unknown"] },
        "verification_status": { "enum": ["verified", "partially_verified", "unverified", "unavailable"] },
        "verified_at": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "enabled", "label", "country_code", "city", "location_confidence", "sources", "endpoints"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "enabled": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "city": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
        "location_confidence": { "enum": ["operator_documented", "provider_advertised", "directory_listed", "unverified"] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/endpoint" }
        }
      }
    }
  }
}
